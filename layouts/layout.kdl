            size "20%"
            stacked true
            split_direction "horizontal"
            pane {
              cwd "/${HOME}/code/ed1001/functional-services/"
              name "1" 
            }
            pane {
              cwd "/${HOME}/code/ed1001/functional-services/"
              name "2" 
            }
            pane { 
              cwd "/${HOME}/code/ed1001/functional-services/"
              name "3" 
            }
          }
      }
      pane size=1 borderless=true {
